rules_version = '2';
// Generated by scripts/write-rules.mjs from fluently.config.json. Do not edit by hand.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ["kishoarwasif2000@gmail.com", "kishoarwasif@gmail.com"];
    }

    // One document per student. A student can read and write only their own document.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.emailOptIn is bool;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.emailOptIn is bool;

      allow delete: if false;
    }

    // Nothing else can be read or written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
